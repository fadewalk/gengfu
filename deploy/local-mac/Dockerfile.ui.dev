FROM node:20-alpine AS base

FROM base AS deps
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk add --no-cache libc6-compat
WORKDIR /app/keep-ui
COPY keep-ui/package.json keep-ui/package-lock.json ./
RUN npm ci --noproxy registry.npmjs.org --maxsockets 1

FROM base AS dev
WORKDIR /app/keep-ui
COPY --from=deps /app/keep-ui/node_modules ./node_modules

ENV NEXT_TELEMETRY_DISABLED=1
ENV SENTRY_DISABLED=true
ENV PORT=3000

EXPOSE 3000

CMD ["npx", "next", "dev", "-H", "0.0.0.0", "--turbopack"]
