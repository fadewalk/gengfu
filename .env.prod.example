# Keep Production Environment Variables
# Copy this file to .env.prod and edit values: cp .env.prod.example .env.prod

# ============ Auth ============
# Options: NO_AUTH, DB, SINGLE_TENANT, OIDC, SAML, LDAP, AZUREAD
AUTH_TYPE=NO_AUTH

# JWT secret (required for DB auth and other auth types)
# KEEP_JWT_SECRET=change-me-to-a-random-string

# Default admin user (only for DB auth)
# KEEP_DEFAULT_USERNAME=admin
# KEEP_DEFAULT_PASSWORD=admin

# NextAuth secret (auto-generated if not set, but set for production)
# NEXTAUTH_SECRET=change-me-to-a-random-string

# ============ Database ============
# Default: SQLite (file-based, no extra setup)
DATABASE_CONNECTION_STRING=sqlite:////state/db.sqlite3?check_same_thread=False

# PostgreSQL example:
# DATABASE_CONNECTION_STRING=postgresql://keep:keep@keep-postgres:5432/keep

# ============ Ports ============
FRONTEND_PORT=4000
BACKEND_PORT=8080
WEBSOCKET_PORT=6001
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8081

# ============ URLs ============
NEXTAUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============ Private LLM (AI features) ============
# Uncomment and fill to use your own LLM (GLM-5, Kimi-2.5, etc.)
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=http://your-llm-endpoint/v1
# OPENAI_MODEL_NAME=glm-5

# ============ WebSocket (Pusher/Soketi) ============
PUSHER_APP_KEY=keepappkey
PUSHER_APP_SECRET=keepappsecret
