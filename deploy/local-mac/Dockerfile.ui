FROM node:20-alpine AS base

FROM base AS deps
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk add --no-cache libc6-compat bash
WORKDIR /app
COPY keep-ui/package.json keep-ui/package-lock.json ./
COPY keep-ui/patches ./patches
COPY keep-ui/scripts ./scripts
RUN npm config set registry https://registry.npmmirror.com && \
    npm ci && \
    npx patch-package

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY keep-ui/ .

ARG OPENAI_API_KEY
ENV OPENAI_API_KEY=$OPENAI_API_KEY
ENV NEXT_TELEMETRY_DISABLED 1
ENV API_URL http://localhost:8080
ENV NEXT_LINT_IGNORE=1
ENV SENTRY_DISABLED=true
RUN NODE_OPTIONS=--max-old-space-size=16384 npx next build --no-lint

FROM base AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1
ENV PORT 3000

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
RUN chgrp -R 0 /app && chmod -R g=u /app && chmod -R a+rX /app/public
USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
